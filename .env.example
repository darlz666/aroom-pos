# Copy to .env and replace the placeholders with local PostgreSQL credentials.
# Server-side only. Never commit real credentials.
DATABASE_URL="postgresql://aroom:CHANGE_ME@localhost:5432/aroom_pos?schema=public"

# Server-only session signing secret. Configure a strong random secret generated
# from at least 32 random bytes in local/production environments. Never commit it.
# Required only when session signing/verification is invoked, not during build.
SESSION_SECRET=""
