generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CASHIER
  STOCK_MANAGEMENT
  FINANCE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BCA_EDC
  MIDTRANS_QRIS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

// Symbols intentionally retain their standard spelling. Persisted inventory
// quantities use g, ml or pcs; kg and L are accepted conversion inputs.
enum InventoryUnit {
  g
  kg
  ml
  L
  pcs
}

enum StockMovementType {
  PURCHASE
  SALE_CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

// All money fields store integer Indonesian rupiah.
// Timestamps store instants; business dates must use Asia/Jakarta.
model User {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  loginIdentifier String          @unique
  passwordHash    String
  role            UserRole
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  shifts          Shift[]
  orders          Order[]
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  stockIns        StockIn[]
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  products     Product[]
}

model Product {
  id         String      @id @default(uuid()) @db.Uuid
  categoryId String      @db.Uuid
  name       String
  price      Int
  available  Boolean     @default(true)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  recipe     Recipe?

  @@index([categoryId])
}

model Shift {
  id           String      @id @default(uuid()) @db.Uuid
  cashierId    String      @db.Uuid
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now()) @db.Timestamptz(3)
  closedAt     DateTime?   @db.Timestamptz(3)
  openingCash  Int
  // Closing values remain unset until the shift is closed.
  expectedCash Int?
  countedCash  Int?
  variance     Int?
  closingNote  String?
  cashier      User        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  orders       Order[]

  @@index([cashierId])
}

model Order {
  id                       String      @id @default(uuid()) @db.Uuid
  orderNumber              String      @unique
  // SQL migration enforces revision >= 1; services increment once per mutation.
  revision                 Int         @default(1)
  // Original create request only; immutable via SQL trigger, never UI data.
  createIdempotencyKey     String      @unique @db.Uuid
  createRequestFingerprint String
  shiftId                  String      @db.Uuid
  cashierId                String      @db.Uuid
  orderType                OrderType
  status                   OrderStatus @default(UNPAID)
  total                    Int
  createdAt                DateTime    @default(now()) @db.Timestamptz(3)
  paidAt                   DateTime?   @db.Timestamptz(3)
  cancelledAt              DateTime?   @db.Timestamptz(3)
  shift                    Shift       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  cashier                  User        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items                    OrderItem[]
  payments                 Payment[]

  @@index([shiftId])
  @@index([cashierId])
  @@index([createdAt])
  @@index([status, paidAt])
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @db.Uuid
  productId           String  @db.Uuid
  // Receipt snapshots must not change when the product changes.
  productNameSnapshot String
  unitPriceSnapshot   Int
  quantity            Int
  notes               String?
  lineTotal           Int
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String                @id @default(uuid()) @db.Uuid
  orderId           String                @db.Uuid
  method            PaymentMethod
  status            PaymentStatus         @default(PENDING)
  amount            Int
  attemptIdentifier String                @unique
  // Server-computed original intent, including authenticated actor; null for legacy attempts.
  requestFingerprint String?
  // SQL migration enforces one PENDING/SUCCEEDED attempt per order and payment integrity.
  cashReceived      Int?
  changeAmount      Int?
  edcReference      String?
  midtransReference String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  succeededAt       DateTime?             @db.Timestamptz(3)
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  notifications     PaymentNotification[]
  stockMovements    StockMovement[]

  @@index([orderId])
  @@index([midtransReference])
  @@index([status, createdAt])
  @@index([status, succeededAt])
}

model PaymentNotification {
  id                     String    @id @default(uuid()) @db.Uuid
  paymentId              String    @db.Uuid
  provider               String
  // Identifies a distinct provider event, not just its payment.
  notificationIdentifier String    @unique
  processingResult       String?
  receivedAt             DateTime  @default(now()) @db.Timestamptz(3)
  processedAt            DateTime? @db.Timestamptz(3)
  payment                Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId, createdAt])
}

model Ingredient {
  id           String          @id @default(uuid()) @db.Uuid
  // SQL unique index on lower(btrim(name)) prevents duplicate physical items.
  name         String
  baseUnit     InventoryUnit
  currentStock Decimal         @default(0) @db.Decimal(18, 3)
  minimumStock Decimal         @default(0) @db.Decimal(18, 3)
  active       Boolean         @default(true)
  // Preserved pre-7E metadata, frozen by SQL; never a costing authority.
  legacyUnitCost Int?
  // The sole current cost: integer millionths of rupiah per canonical unit.
  weightedAverageUnitCostMicros BigInt?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  recipeItems  RecipeItem[]
  movements    StockMovement[]
  stockInItems StockInItem[]

  // Composite foreign keys enforce canonical units in recipes and history.
  @@unique([id, baseUnit])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  contact   String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  stockIns  StockIn[]
}

// Posted receiving records are immutable. Retry keys identify original intent.
model StockIn {
  id                 String        @id @default(uuid()) @db.Uuid
  referenceNumber    String        @unique
  idempotencyKey     String        @unique @db.Uuid
  requestFingerprint String
  supplierId         String        @db.Uuid
  supplierNameSnapshot String
  receivedAt         DateTime      @db.Timestamptz(3)
  actorId            String        @db.Uuid
  notes              String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  supplier           Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  actor              User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  items              StockInItem[]

  @@index([supplierId, receivedAt])
  @@index([actorId])
}

model StockInItem {
  id                     String        @id @default(uuid()) @db.Uuid
  stockInId              String        @db.Uuid
  ingredientId           String        @db.Uuid
  ingredientNameSnapshot String
  inputQuantity          Decimal       @db.Decimal(18, 3)
  inputUnit              InventoryUnit
  baseQuantity           Decimal       @db.Decimal(18, 3)
  baseUnit               InventoryUnit
  // Integer rupiah per ONE canonical base unit, independent of inputUnit.
  unitCost               Int?
  // New input contract: original whole-rupiah price per inputUnit.
  purchaseUnitCost       Int?
  // Immutable normalized receiving cost; null only on pre-7E history.
  receivedUnitCostMicros BigInt?
  lineTotal              Int
  stockIn                StockIn       @relation(fields: [stockInId], references: [id], onDelete: Restrict)
  ingredient             Ingredient    @relation(fields: [ingredientId, baseUnit], references: [id, baseUnit], onDelete: Restrict, onUpdate: Restrict)

  @@unique([stockInId, ingredientId])
  @@index([ingredientId, baseUnit])
}

model Recipe {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @unique @db.Uuid
  revision  Int          @default(1)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  items     RecipeItem[]
}

model RecipeItem {
  id           String        @id @default(uuid()) @db.Uuid
  recipeId     String        @db.Uuid
  ingredientId String        @db.Uuid
  quantity     Decimal       @db.Decimal(18, 3)
  unit         InventoryUnit
  recipe       Recipe        @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  ingredient   Ingredient    @relation(fields: [ingredientId, unit], references: [id, baseUnit], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId, unit])
}

// Append-only SQL protection: corrections will be new movements, never edits.
// Receiving writes PURCHASE movements atomically with the shared balance.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  ingredientId String            @db.Uuid
  type         StockMovementType
  // Positive magnitude; the movement type determines direction.
  quantity     Decimal           @db.Decimal(18, 3)
  unit         InventoryUnit
  stockAfter   Decimal           @db.Decimal(18, 3)
  sourceType   String?
  sourceId     String?           @db.Uuid
  actorId      String?           @db.Uuid
  // Sale identity; order is available through the immutable Payment.orderId.
  paymentId    String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  ingredient   Ingredient        @relation(fields: [ingredientId, unit], references: [id, baseUnit], onDelete: Restrict, onUpdate: Restrict)
  actor        User?             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  payment      Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, ingredientId])
  @@index([ingredientId, createdAt])
  @@index([sourceType, sourceId])
  @@index([actorId])
}
